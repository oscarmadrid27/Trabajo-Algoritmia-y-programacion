      "cell_type": "code",
      "source": [
        "# PrestApp - Gestor de Prestamos\n",
        "\n",
        "\n",
        "import csv\n",
        "import os\n",
        "import random\n",
        "from datetime import datetime\n",
        "\n",
        "# Nombres de los archivos csv\n",
        "\n",
        "ARCHIVO_USUARIOS  = \"usuarios.csv\"\n",
        "ARCHIVO_ITEMS     = \"items.csv\"\n",
        "ARCHIVO_PRESTAMOS = \"prestamos.csv\"\n",
        "ARCHIVO_VENTAS    = \"ventas.csv\"\n",
        "\n",
        "\n",
        "# Clases\n",
        "\n",
        "class clsUsuarios:\n",
        "    def __init__(self, nombre, apellido, documento, correo, dias):\n",
        "        self.nombre    = nombre\n",
        "        self.apellido  = apellido\n",
        "        self.documento = documento\n",
        "        self.correo    = correo\n",
        "        self.dias      = dias\n",
        "\n",
        "\n",
        "class clsPrestamo:\n",
        "    def __init__(self, id_prestamo, documento, id_item,\n",
        "                 nombre_item, fecha_inicio, dias, precio):\n",
        "        self.id_prestamo  = id_prestamo\n",
        "        self.documento    = documento\n",
        "        self.id_item      = id_item\n",
        "        self.nombre_item  = nombre_item\n",
        "        self.fecha_inicio = fecha_inicio\n",
        "        self.dias         = dias\n",
        "        self.precio       = precio\n",
        "\n",
        "# Crear archivos\n",
        "# Si el archivo no existe lo creamos con sus titulos.\n",
        "# Usamos try/except: intentamos abrirlo, si falla lo creamos.\n",
        "\n",
        "def crear_archivos():\n",
        "    try:\n",
        "        open(ARCHIVO_USUARIOS, \"r\").close()\n",
        "    except:\n",
        "        with open(ARCHIVO_USUARIOS, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "            csv.writer(f).writerow([\"nombre\",\"apellido\",\"documento\",\"correo\",\"dias\"])\n",
        "\n",
        "    try:\n",
        "        open(ARCHIVO_ITEMS, \"r\").close()\n",
        "    except:\n",
        "        with open(ARCHIVO_ITEMS, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "            csv.writer(f).writerow([\"id_item\",\"nombre\",\"categoria\",\"precio\",\"estado\",\"disponible\"])\n",
        "\n",
        "    try:\n",
        "        open(ARCHIVO_PRESTAMOS, \"r\").close()\n",
        "    except:\n",
        "        with open(ARCHIVO_PRESTAMOS, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "            csv.writer(f).writerow([\"id_prestamo\",\"documento\",\"id_item\",\n",
        "                                    \"nombre_item\",\"fecha_inicio\",\"dias\",\"precio\",\"activo\"])\n",
        "\n",
        "    try:\n",
        "        open(ARCHIVO_VENTAS, \"r\").close()\n",
        "    except:\n",
        "        with open(ARCHIVO_VENTAS, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "            csv.writer(f).writerow([\"id\",\"documento\",\"item\",\"subtotal\",\"impuesto\",\"total\",\"fecha\"])\n",
        "\n",
        "\n",
        "# Leer archivos CSV\n",
        "# Leemos cada archivo y devolvemos una lista de diccionarios.\n",
        "\n",
        "def leer_usuarios():\n",
        "    lista = []\n",
        "    with open(ARCHIVO_USUARIOS, newline=\"\", encoding=\"utf-8\") as f:\n",
        "        for fila in csv.DictReader(f):\n",
        "            lista.append(fila)\n",
        "    return lista\n",
        "\n",
        "def leer_items():\n",
        "    lista = []\n",
        "    with open(ARCHIVO_ITEMS, newline=\"\", encoding=\"utf-8\") as f:\n",
        "        for fila in csv.DictReader(f):\n",
        "            lista.append(fila)\n",
        "    return lista\n",
        "\n",
        "def leer_prestamos():\n",
        "    lista = []\n",
        "    with open(ARCHIVO_PRESTAMOS, newline=\"\", encoding=\"utf-8\") as f:\n",
        "        for fila in csv.DictReader(f):\n",
        "            lista.append(fila)\n",
        "    return lista\n",
        "\n",
        "def leer_ventas():\n",
        "    lista = []\n",
        "    with open(ARCHIVO_VENTAS, newline=\"\", encoding=\"utf-8\") as f:\n",
        "        for fila in csv.DictReader(f):\n",
        "            lista.append(fila)\n",
        "    return lista\n",
        "\n",
        "\n",
        "# Guarda archivos CSV\n",
        "# Reescribimos todo el archivo con los datos actualizados.\n",
        "\n",
        "def guardar_items(lista):\n",
        "    with open(ARCHIVO_ITEMS, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "        w = csv.writer(f)\n",
        "        w.writerow([\"id_item\",\"nombre\",\"categoria\",\"precio\",\"estado\",\"disponible\"])\n",
        "        for item in lista:\n",
        "            w.writerow([item[\"id_item\"], item[\"nombre\"], item[\"categoria\"],\n",
        "                        item[\"precio\"], item[\"estado\"], item[\"disponible\"]])\n",
        "\n",
        "def guardar_prestamos(lista):\n",
        "    with open(ARCHIVO_PRESTAMOS, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "        w = csv.writer(f)\n",
        "        w.writerow([\"id_prestamo\",\"documento\",\"id_item\",\"nombre_item\",\n",
        "                    \"fecha_inicio\",\"dias\",\"precio\",\"activo\"])\n",
        "        for p in lista:\n",
        "            w.writerow([p[\"id_prestamo\"], p[\"documento\"], p[\"id_item\"],\n",
        "                        p[\"nombre_item\"], p[\"fecha_inicio\"], p[\"dias\"],\n",
        "                        p[\"precio\"], p[\"activo\"]])\n",
        "\n",
        "\n",
        "# Validaciones\n",
        "\n",
        "def validar_nombre(texto):\n",
        "    if len(texto) < 3:\n",
        "        print(\"  Debe tener al menos 3 letras.\")\n",
        "        return False\n",
        "    for caracter in texto:\n",
        "        if caracter.isdigit():\n",
        "            print(\"  No puede contener numeros.\")\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "def validar_documento(doc):\n",
        "    if not doc.isdigit():\n",
        "        print(\"  Solo se permiten numeros.\")\n",
        "        return False\n",
        "    if len(doc) < 3 or len(doc) > 15:\n",
        "        print(\"  Debe tener entre 3 y 15 digitos.\")\n",
        "        return False\n",
        "    return True\n",
        "\n",
        "def validar_correo(correo):\n",
        "    if \"@\" not in correo:\n",
        "        print(\"  El correo debe tener @.\")\n",
        "        return False\n",
        "    if not correo.endswith(\".com\"):\n",
        "        print(\"  El correo debe terminar en .com\")\n",
        "        return False\n",
        "    return True\n",
        "\n",
        "\n",
        "# Logica difusa - estado del item\n",
        "\n",
        "def pedir_estado():\n",
        "    while True:\n",
        "        try:\n",
        "            puntaje = float(input(\"  Puntaje del estado (0 a 10): \"))\n",
        "            if puntaje < 0 or puntaje > 10:\n",
        "                print(\"  Debe estar entre 0 y 10.\")\n",
        "                continue\n",
        "            if puntaje >= 8.5:\n",
        "                estado = \"Excelente\"\n",
        "            elif puntaje >= 6.5:\n",
        "                estado = \"Bueno\"\n",
        "            elif puntaje >= 4.0:\n",
        "                estado = \"Regular\"\n",
        "            else:\n",
        "                estado = \"Malo\"\n",
        "            print(\"  Estado: \" + estado)\n",
        "            return estado\n",
        "        except ValueError:\n",
        "            print(\"  Escribe un numero valido.\")\n",
        "\n",
        "\n",
        "# Generar IDs\n",
        "\n",
        "PREFIJOS = {\n",
        "    \"1\": \"VJ\", \"2\": \"LB\", \"3\": \"MV\",\n",
        "    \"4\": \"HE\", \"5\": \"DN\", \"6\": \"MS\"\n",
        "}\n",
        "\n",
        "def generar_id_item(num_cat):\n",
        "    return PREFIJOS[num_cat] + \"-\" + str(random.randint(1000, 9999))\n",
        "\n",
        "def generar_id_prestamo():\n",
        "    return \"P-\" + str(random.randint(1000, 9999))\n",
        "\n",
        "\n",
        "# Pantalla\n",
        "\n",
        "LINEA = \"-\" * 48\n",
        "\n",
        "def limpiar():\n",
        "    os.system(\"cls\" if os.name == \"nt\" else \"clear\")\n",
        "\n",
        "def mostrar_menu():\n",
        "    limpiar()\n",
        "    print(LINEA)\n",
        "    print(\"        PRESTAPP - Gestor de Prestamos\")\n",
        "    print(LINEA)\n",
        "    print(\"  1. Registrar Usuario\")\n",
        "    print(\"  2. Registrar Item\")\n",
        "    print(\"  3. Registrar Prestamo\")\n",
        "    print(\"  4. Registrar Devolucion\")\n",
        "    print(\"  5. Items con mas de 30 dias prestados\")\n",
        "    print(\"  6. Ver articulos prestados\")\n",
        "    print(\"  7. Administrador\")\n",
        "    print(\"  8. Salir\")\n",
        "    print(LINEA)\n",
        "\n",
        "\n",
        "# Opcion 1 - registrar usuario\n",
        "\n",
        "def registrar_usuario():\n",
        "    limpiar()\n",
        "    print(LINEA)\n",
        "    print(\"        REGISTRAR USUARIO\")\n",
        "    print(LINEA)\n",
        "\n",
        "    nombre = \"\"\n",
        "    while not validar_nombre(nombre):\n",
        "        nombre = input(\"  Nombre    : \").strip()\n",
        "\n",
        "    apellido = \"\"\n",
        "    while not validar_nombre(apellido):\n",
        "        apellido = input(\"  Apellido  : \").strip()\n",
        "\n",
        "    documento = \"\"\n",
        "    while not validar_documento(documento):\n",
        "        documento = input(\"  Documento : \").strip()\n",
        "\n",
        "    correo = \"\"\n",
        "    while not validar_correo(correo):\n",
        "        correo = input(\"  Correo    : \").strip()\n",
        "\n",
        "    dias = \"\"\n",
        "    while dias not in [\"5\", \"10\", \"15\", \"30\"]:\n",
        "        print(\"  Opciones: 5 / 10 / 15 / 30\")\n",
        "        dias = input(\"  Dias      : \").strip()\n",
        "        if dias not in [\"5\", \"10\", \"15\", \"30\"]:\n",
        "            print(\"  Solo se permiten esos valores.\")\n",
        "\n",
        "    # Revisamos que el documento no este repetido\n",
        "    for u in leer_usuarios():\n",
        "        if u[\"documento\"] == documento:\n",
        "            print(\"\\n  Ese documento ya existe.\")\n",
        "            input(\"  Enter para continuar...\")\n",
        "            return\n",
        "\n",
        "    # Creamos el objeto con la clase clsUsuarios\n",
        "    nuevo = clsUsuarios(nombre, apellido, documento, correo, dias)\n",
        "\n",
        "    # Guardamos en el CSV\n",
        "    with open(ARCHIVO_USUARIOS, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "        csv.writer(f).writerow([nuevo.nombre, nuevo.apellido,\n",
        "                                 nuevo.documento, nuevo.correo, nuevo.dias])\n",
        "\n",
        "    print(\"\\n  Usuario registrado: \" + nombre + \" \" + apellido)\n",
        "    input(\"  Enter para continuar...\")\n",
        "\n",
        "\n",
        "# Opcion 2 - registrar item\n",
        "\n",
        "def registrar_item():\n",
        "    limpiar()\n",
        "    print(LINEA)\n",
        "    print(\"        REGISTRAR ITEM\")\n",
        "    print(LINEA)\n",
        "\n",
        "    nombre = \"\"\n",
        "    while len(nombre) < 3:\n",
        "        nombre = input(\"  Nombre del item: \").strip()\n",
        "        if len(nombre) < 3:\n",
        "            print(\"  Debe tener al menos 3 caracteres.\")\n",
        "\n",
        "    print(\"\\n  Categorias:\")\n",
        "    print(\"   1. Videojuegos    2. Libros\")\n",
        "    print(\"   3. Musica y video 4. Herramientas\")\n",
        "    print(\"   5. Dinero         6. Miscelaneo y varios\")\n",
        "\n",
        "    categorias = {\n",
        "        \"1\": \"Videojuegos\", \"2\": \"Libros\",\n",
        "        \"3\": \"Musica y video\", \"4\": \"Herramientas\",\n",
        "        \"5\": \"Dinero\", \"6\": \"Miscelaneo y varios\"\n",
        "    }\n",
        "\n",
        "    cat_num = \"\"\n",
        "    while cat_num not in categorias:\n",
        "        cat_num = input(\"  Elige (1-6): \").strip()\n",
        "        if cat_num not in categorias:\n",
        "            print(\"  Opcion invalida.\")\n",
        "\n",
        "    categoria = categorias[cat_num]\n",
        "\n",
        "    precio = 0\n",
        "    while precio <= 0:\n",
        "        try:\n",
        "            precio = float(input(\"  Precio de compra: $\"))\n",
        "            if precio <= 0:\n",
        "                print(\"  El precio debe ser mayor a 0.\")\n",
        "        except ValueError:\n",
        "            print(\"  Escribe un numero.\")\n",
        "            precio = 0\n",
        "\n",
        "    estado  = pedir_estado()\n",
        "    id_item = generar_id_item(cat_num)\n",
        "\n",
        "    with open(ARCHIVO_ITEMS, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "        csv.writer(f).writerow([id_item, nombre, categoria, precio, estado, \"1\"])\n",
        "\n",
        "    print(\"\\n  Item guardado con ID: \" + id_item)\n",
        "    input(\"  Enter para continuar...\")\n",
        "\n",
        "\n",
        "# Opcion 3 - registrar prestamo\n",
        "\n",
        "def registrar_prestamo():\n",
        "    limpiar()\n",
        "    print(LINEA)\n",
        "    print(\"        REGISTRAR PRESTAMO\")\n",
        "    print(LINEA)\n",
        "\n",
        "    items = leer_items()\n",
        "\n",
        "    disponibles = []\n",
        "    for item in items:\n",
        "        if item[\"disponible\"] == \"1\":\n",
        "            disponibles.append(item)\n",
        "\n",
        "    if len(disponibles) == 0:\n",
        "        print(\"  No hay items disponibles.\")\n",
        "        input(\"  Enter para continuar...\")\n",
        "        return\n",
        "\n",
        "    print(\"\\n  Items disponibles:\")\n",
        "    print(\"  \" + \"-\" * 44)\n",
        "    for item in disponibles:\n",
        "        print(\"  \" + item[\"id_item\"] + \" | \" + item[\"nombre\"] +\n",
        "              \" | $\" + item[\"precio\"] + \" | \" + item[\"estado\"])\n",
        "\n",
        "    print()\n",
        "    id_elegido = input(\"  ID del item: \").strip().upper()\n",
        "\n",
        "    item_elegido = None\n",
        "    for item in disponibles:\n",
        "        if item[\"id_item\"].upper() == id_elegido:\n",
        "            item_elegido = item\n",
        "\n",
        "    if item_elegido is None:\n",
        "        print(\"  Ese ID no existe.\")\n",
        "        input(\"  Enter para continuar...\")\n",
        "        return\n",
        "\n",
        "    doc = input(\"  Documento del amigo: \").strip()\n",
        "\n",
        "    usuario_encontrado = None\n",
        "    for u in leer_usuarios():\n",
        "        if u[\"documento\"] == doc:\n",
        "            usuario_encontrado = u\n",
        "\n",
        "    if usuario_encontrado is None:\n",
        "        print(\"  Ese usuario no esta registrado.\")\n",
        "        print(\"  Primero registralo en la opcion 1.\")\n",
        "        input(\"  Enter para continuar...\")\n",
        "        return\n",
        "\n",
        "    id_prestamo  = generar_id_prestamo()\n",
        "    fecha_inicio = datetime.today().strftime(\"%d/%m/%Y\")\n",
        "\n",
        "    nuevo_prestamo = clsPrestamo(\n",
        "        id_prestamo, doc,\n",
        "        item_elegido[\"id_item\"], item_elegido[\"nombre\"],\n",
        "        fecha_inicio, usuario_encontrado[\"dias\"],\n",
        "        item_elegido[\"precio\"]\n",
        "    )\n",
        "\n",
        "    with open(ARCHIVO_PRESTAMOS, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "        csv.writer(f).writerow([\n",
        "            nuevo_prestamo.id_prestamo, nuevo_prestamo.documento,\n",
        "            nuevo_prestamo.id_item, nuevo_prestamo.nombre_item,\n",
        "            nuevo_prestamo.fecha_inicio, nuevo_prestamo.dias,\n",
        "            nuevo_prestamo.precio, \"1\"\n",
        "        ])\n",
        "\n",
        "    for item in items:\n",
        "        if item[\"id_item\"] == item_elegido[\"id_item\"]:\n",
        "            item[\"disponible\"] = \"0\"\n",
        "    guardar_items(items)\n",
        "\n",
        "    print(\"\\n  Prestamo registrado!\")\n",
        "    print(\"     ID    : \" + id_prestamo)\n",
        "    print(\"     Item  : \" + item_elegido[\"nombre\"])\n",
        "    print(\"     Amigo : \" + usuario_encontrado[\"nombre\"])\n",
        "    print(\"     Fecha : \" + fecha_inicio)\n",
        "    input(\"\\n  Enter para continuar...\")\n",
        "\n",
        "\n",
        "# Opcion 4 - registrar devolucion\n",
        "\n",
        "def registrar_devolucion():\n",
        "    limpiar()\n",
        "    print(LINEA)\n",
        "    print(\"        REGISTRAR DEVOLUCION\")\n",
        "    print(LINEA)\n",
        "\n",
        "    doc = input(\"  Documento del usuario: \").strip()\n",
        "\n",
        "    prestamos = leer_prestamos()\n",
        "    activos   = []\n",
        "    for p in prestamos:\n",
        "        if p[\"documento\"] == doc and p[\"activo\"] == \"1\":\n",
        "            activos.append(p)\n",
        "\n",
        "    if len(activos) == 0:\n",
        "        print(\"  Este usuario no tiene prestamos activos.\")\n",
        "        input(\"  Enter para continuar...\")\n",
        "        return\n",
        "\n",
        "    print(\"\\n  Prestamos activos:\")\n",
        "    print(\"  \" + \"-\" * 38)\n",
        "    for p in activos:\n",
        "        inicio       = datetime.strptime(p[\"fecha_inicio\"], \"%d/%m/%Y\")\n",
        "        dias_pasados = (datetime.today() - inicio).days\n",
        "        print(\"  \" + p[\"id_prestamo\"] + \" | \" +\n",
        "              p[\"nombre_item\"] + \" | \" +\n",
        "              str(dias_pasados) + \" dias\")\n",
        "\n",
        "    print()\n",
        "    id_dev = input(\"  ID del prestamo a devolver: \").strip().upper()\n",
        "\n",
        "    prestamo_elegido = None\n",
        "    for p in activos:\n",
        "        if p[\"id_prestamo\"].upper() == id_dev:\n",
        "            prestamo_elegido = p\n",
        "\n",
        "    if prestamo_elegido is None:\n",
        "        print(\"  Ese ID no fue encontrado.\")\n",
        "        input(\"  Enter para continuar...\")\n",
        "        return\n",
        "\n",
        "    for p in prestamos:\n",
        "        if p[\"id_prestamo\"] == prestamo_elegido[\"id_prestamo\"]:\n",
        "            p[\"activo\"] = \"0\"\n",
        "    guardar_prestamos(prestamos)\n",
        "\n",
        "    items = leer_items()\n",
        "    for item in items:\n",
        "        if item[\"id_item\"] == prestamo_elegido[\"id_item\"]:\n",
        "            item[\"disponible\"] = \"1\"\n",
        "    guardar_items(items)\n",
        "\n",
        "    nombre_usuario = doc\n",
        "    for u in leer_usuarios():\n",
        "        if u[\"documento\"] == doc:\n",
        "            nombre_usuario = u[\"nombre\"] + \"_\" + u[\"apellido\"]\n",
        "\n",
        "    fecha_hoy     = datetime.today().strftime(\"%d/%m/%Y\")\n",
        "    fecha_archivo = datetime.today().strftime(\"%Y%m%d\")\n",
        "    nombre_cert   = (\"cert_\" + nombre_usuario + \"_\" +\n",
        "                     fecha_archivo + \"_\" +\n",
        "                     prestamo_elegido[\"id_prestamo\"] + \".txt\")\n",
        "\n",
        "    archivo = open(nombre_cert, \"w\", encoding=\"utf-8\")\n",
        "    archivo.write(\"=\" * 44 + \"\\n\")\n",
        "    archivo.write(\"   CERTIFICADO DE DEVOLUCION - PrestApp\\n\")\n",
        "    archivo.write(\"=\" * 44 + \"\\n\")\n",
        "    archivo.write(\"ID Prestamo   : \" + prestamo_elegido[\"id_prestamo\"] + \"\\n\")\n",
        "    archivo.write(\"Documento     : \" + doc + \"\\n\")\n",
        "    archivo.write(\"Item          : \" + prestamo_elegido[\"nombre_item\"] + \"\\n\")\n",
        "    archivo.write(\"Fecha prestamo: \" + prestamo_elegido[\"fecha_inicio\"] + \"\\n\")\n",
        "    archivo.write(\"Fecha devol.  : \" + fecha_hoy + \"\\n\")\n",
        "    archivo.write(\"=\" * 44 + \"\\n\")\n",
        "    archivo.write(\"  Devolucion registrada correctamente.\\n\")\n",
        "    archivo.write(\"=\" * 44 + \"\\n\")\n",
        "    archivo.close()\n",
        "\n",
        "    print(\"\\n  Devolucion registrada.\")\n",
        "    print(\"     Certificado: \" + nombre_cert)\n",
        "    input(\"\\n  Enter para continuar...\")\n",
        "\n",
        "\n",
        "# Opcion 5 - items con mas de 30 dias\n",
        "\n",
        "def items_mas_30_dias():\n",
        "    limpiar()\n",
        "    print(LINEA)\n",
        "    print(\"     ITEMS CON MAS DE 30 DIAS PRESTADOS\")\n",
        "    print(LINEA)\n",
        "\n",
